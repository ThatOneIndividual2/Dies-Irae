{
  "events": [
    {
      "key": "plague_omen_in_the_parish",
      "title": "An omen in the parish",
      "body": "The sexton buried too many this week for the season. A child swears the bells rang with no ringer. The priest wants a procession. The steward wants the roads left open.",
      "category": "supernatural_omen",
      "scope": "territory",
      "visibility": "player",
      "weight": 22,
      "weight_modifiers": [
        { "when": { "plague_active": true }, "add": 30 },
        { "when": { "min_apocalypse_phase_ordinal": 2 }, "add": 12 }
      ],
      "cooldown_days": 25,
      "exclusivity": "omen_watch",
      "trigger": {
        "any_of": [
          { "plague_active": true },
          { "min_apocalypse_meters": { "plague_severity": 10 } },
          { "min_territory": { "despair": 15 } }
        ]
      },
      "choices": [
        {
          "key": "procession",
          "label": "Hold a procession",
          "ai": { "base": 30, "modifiers": [{ "when": { "min_church_standing": 10 }, "add": 15 }] },
          "immediate": [
            { "op": "add_despair", "delta": -4 },
            { "op": "add_treasury", "delta": -5 }
          ],
          "hidden": [
            { "op": "add_church_standing", "delta": 3 },
            { "op": "apocalypse_signal", "signal": "pilgrimage", "magnitude": 6 }
          ]
        },
        {
          "key": "keep_roads",
          "label": "Keep the roads open",
          "ai": { "base": 25 },
          "immediate": [
            { "op": "add_plague_intensity", "delta": 1 },
            { "op": "add_despair", "delta": 3 }
          ]
        }
      ]
    },
